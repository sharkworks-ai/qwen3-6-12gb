{
  "preset": "extreme",
  "source_model": "/data/checkpoints/qwen36-merged",
  "output_dir": "/data/artifacts/extreme",
  "calibration_file": "/data/datasets/ayot.jsonl",
  "attention_bits": 4,
  "shared_bits": 4,
  "group_size": 64,
  "context_length": 262144,
  "steps": 100,
  "row_chunk": 64,
