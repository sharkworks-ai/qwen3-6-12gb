# Never commit real credentials.
HF_TOKEN=
GITHUB_TOKEN=
QWEN12G_ARTIFACT_ROOT=./artifacts
QWEN12G_RUN_ROOT=./runs

# Laptop control plane
QWEN12G_DOCKER_CONTEXT=qwen5090
QWEN12G_WORKER_CONFIG=configs/worker/dual5090.yaml

# Appliance (root docker-compose.yml)
QWEN12G_WEB_TOKEN=
QWEN12G_IMAGE=ghcr.io/sharkworks-ai/qwen3-6-12gb:latest
QWEN12G_BIND=127.0.0.1
QWEN12G_PORT=8080
QWEN12G_SECURE_COOKIE=0
QWEN12G_DATA_VOLUME=qwen12g-data
QWEN12G_BENCHMARK_PROFILES=
