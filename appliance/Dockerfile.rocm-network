# Build Dockerfile.rocm first, then keep its large /opt runtimes on shared storage.
ARG ROCM_APPLIANCE_IMAGE=qwen12g-appliance:rocm
FROM ${ROCM_APPLIANCE_IMAGE} AS full
FROM ubuntu:24.04
# Preserve the exact OS libraries used by the full image, including Python's ABI.
COPY --from=full /usr /usr
COPY --from=full /etc/ld.so.conf.d /etc/ld.so.conf.d
COPY --from=full /opt/GSQ /opt/GSQ
COPY --from=full /opt/BitTern /opt/BitTern
COPY --from=full /app /app
RUN ln -s /opt/rocm-7.2.0 /opt/rocm && useradd --create-home --uid 10001 appliance && \
    mkdir -p /data/db && chown -R appliance:appliance /data && ldconfig
WORKDIR /app
USER appliance
ENV PATH=/opt/venv/bin:/opt/rocm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/opt/rocm/lib QWEN12G_GPU_BACKEND=rocm QWEN12G_DATA_ROOT=/data \
    HF_HOME=/data/hf-cache XDG_CACHE_HOME=/data/cache PYTHONUNBUFFERED=1 PYTHONPATH=/app TOKENIZERS_PARALLELISM=false
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["python3","-m","appliance.app"]
